<facsimile><graphic url="https://www.e-manuscripta.ch/i3f/v20/1079121/manifest"/></facsimile><text><body><div type="letter">
<pb facs="1079122" n="1"/>
  <opener><salute>Viro <choice><abbr>Illustriss.</abbr><expan>Illustrissimo</expan></choice> et <choice><abbr>Celeberr.<hi rend="sup">o</hi></abbr><expan>Celeberrimo</expan></choice>
      <lb/><choice><abbr>Jo:</abbr><expan>Johanni</expan></choice> <rs key="pers_DE-588-118509969" type="person">Bernoull<choice><orig><g ref="#j">j</g></orig><reg>i</reg></choice></rs>.
      <lb/><rs key="pers_DE-588-102552517" type="person">Petrus <choice><abbr>Ant.<hi rend="sup">us</hi></abbr><expan>Antonius</expan></choice> Michelotti</rs> <abbr>S. P. D.</abbr></salute></opener>
  <p><lb/>Ante octo dies, <rs key="B_991170515151405501" type="letter">litteras</rs> perhumanissimas, quas ad me <choice><abbr>a. d.</abbr><expan>ad diem</expan></choice> 18
      <lb/>Octobris dedisti, accepi, atque magno cum gaudio intellexi
      <lb/>post long<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice> in itinere mor<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice> fascicul<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice>, de quo toties ad
      <lb/>Te perscripser<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice>, tand<choice><orig><g ref="#em">ē</g></orig><reg>em</reg></choice> ad tuas pervenisse manus.
      <lb/>Quod humanissime promittis, Te quam prim<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> fieri po<pc type="hyphenation">-</pc><lb break="no"/>terit attente perlectur<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> me<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice> <rs key="biblio_M3G2JA79" type="biblio">Dissertation<choice><orig><g ref="#em">ē</g></orig><reg>em</reg></choice></rs>, monitu<pc type="hyphenation">-</pc><lb break="no"/>rumque qu<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice> in ea notatu digna erunt, et pr<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice>terea exa<pc type="hyphenation">-</pc><lb break="no"/>minatur<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> <rs key="pers_DE-588-1055365613" type="person">Keillii</rs> <rs key="biblio_22EK4JD4 biblio_W3P7C2J2" type="biblio">Tentamina</rs>, et <rs key="pers_DE-588-119507978" type="person">Jurini</rs> propositiones<rs key="biblio_M6Z9EVAL" type="biblio"/>,
      <lb/>mihi maxime pergrat<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> est. Tuas <rs key="biblio_W6BHQDM2 biblio_JAFFCHKU biblio_" type="biblio">Dissertationes</rs> oppid<choice><orig><g ref="#ograv">ò</g></orig><reg>o</reg></choice>
      <lb/>raras, multumque admod<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> pr<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice>claras quam correctissi<pc type="hyphenation">-</pc><lb break="no"/>me fieri poterit recudi curabo. Spero <choice><abbr>Celeber.</abbr><expan>Celeberrimum</expan></choice> meique
      <lb/>Amicissim<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> <rs key="pers_DE-588-119166895" type="person">Agnat<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice></rs> Tu<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> jam istuc salv<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> atque incolu<pc type="hyphenation">-</pc><lb break="no"/>m<choice><orig><g ref="#em">ē</g></orig><reg>em</reg></choice> redjisse. Quoni<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice> ab ipsomet intelliges cur hinc sum<pc type="hyphenation">-</pc><lb break="no"/>mo cum mei dolore discesserit, Tibi rem aperire superse<pc type="hyphenation">-</pc><lb break="no"/>deo. Utcunque res sit ejus fam<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice> ubique tueor, <del>in</del> <choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice>ter<pc type="hyphenation">-</pc><lb break="no"/>numque tuebor; et sane ejus Pat<supplied>r</supplied>oni <choice><abbr>Illustriss.<hi rend="sup">i</hi></abbr><expan>Illustrissimi</expan></choice> et <choice><abbr>Ex<pc type="hyphenation">-</pc><lb break="no"/>cell.<hi rend="sup">mi</hi></abbr><expan>Excellentissimi</expan></choice> adhuc dolent qu<choice><orig><g ref="#ograv">ò</g></orig><reg>o</reg></choice>d non potuerint illius discessum
      <lb/>impedire. Dic ergo meo nomine salut<choice><orig><g ref="#em">ē</g></orig><reg>em</reg></choice> quamplurimam
      <lb/><choice><abbr>Clariss.<hi rend="sup">o</hi></abbr><expan>Clarissimo</expan></choice> <rs key="pers_DE-588-119166895" type="person">Agnato</rs> Tuo, uti eti<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice> Perillustri Tuo Filio <rs key="pers_DE-588-117589144" type="person">Nicolao</rs>
      <lb/>(de quo gaudeo quod <rs key="place_GEO-2925177" type="place">Friburgi</rs> apud <add><choice><abbr>E.</abbr><expan>Excellentiam</expan></choice> <choice><abbr>S.</abbr><expan>Suam</expan></choice></add> Comit<choice><orig><g ref="#em">ē</g></orig><reg>em</reg></choice> de <rs key="pers_DE-588-1012270238" type="person">Harsch</rs> <add>nunc</add> mo<pc type="hyphenation">-</pc><lb break="no"/>retur) et mihi favere perge. Si mense Januarii ha<pc type="hyphenation">-</pc><lb break="no"/>bere poss<choice><orig><g ref="#em">ē</g></orig><reg>em</reg></choice> meam Dissertation<choice><orig><g ref="#em">ē</g></orig><reg>em</reg></choice><note type="editorial" resp="SG">Im <rs type="letter" key="B_991170515151105501">Brief</rs> vom 22. März 1720 bat Michelotti erneut um die Rücksendung des Manuskripts. Im Postskriptum vom 17. Mai zu seinem <rs type="letter" key="B_991170515150805501">Brief</rs> vom 10. Mai meldete er, dass er es samt Bernoullis Anmerkungen zurückerhalten hatte.</note>, et omnia qu<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice> super
      <lb/>ead<choice><orig><g ref="#em">ē</g></orig><reg>em</reg></choice> superque <rs key="pers_DE-588-1055365613" type="person">Keillii</rs> Tentaminibus annotaveris, esset
      <lb/>mihi gratissim<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice>. Ceter<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> antequ<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice> ista omnia ad me
      <lb/>remittas, rogo ut me certior<choice><orig><g ref="#em">ē</g></orig><reg>em</reg></choice> facias ante mens<choice><orig><g ref="#em">ē</g></orig><reg>em</reg></choice>
      <lb/>circiter, videlicet ut possim Tibi significare ad quem
<pb facs="1079123" n="2"/>
      <lb/>transmittere debeas <rs key="place_GEO-3173435" type="place">Mediolan<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice></rs>, fascicul<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice>. Subjicio,
      <lb/>Te mihi r<choice><orig><g ref="#em">ē</g></orig><reg>em</reg></choice> pergrat<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice> factur<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> si me certior<choice><orig><g ref="#em">ē</g></orig><reg>em</reg></choice> feceris
      <lb/>de sumptibus, quos facere<choice><sic>,</sic><corr type="deleted"/></choice> necess<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> esse scio in accipien<pc type="hyphenation">-</pc><lb break="no"/>dis et mittendis litteris. Persolv<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice> enim omnia ea ra<pc type="hyphenation">-</pc><lb break="no"/>tione qua imperabis.</p>
  <closer><dateline>Dab<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice> <rs key="place_GEO-3164603" type="place">Venetiis</rs> <choice><abbr>a. d.</abbr><expan>ad diem</expan></choice> <date when="1719-11-03">3 Novembris
      <lb/>1719.</date></dateline></closer>
<pb facs="1079124" n="3" type="empty"/>
<pb facs="1079125" n="4"/>
  <closer><address>
      <addrLine>A Monsieur</addrLine>
      <addrLine>Monsieur Jean Bernoulli</addrLine>
      <addrLine>Professeur tres Celebre de Matematique</addrLine>
      <note type="postal">franca per <rs key="place_GEO-2775220" type="place">Insprug</rs></note>
      <addrLine><choice><orig>a</orig><reg>à</reg></choice> <rs key="place_GEO-2661604" type="place">Basle</rs>.</addrLine></address></closer> </div></body></text></TEI>