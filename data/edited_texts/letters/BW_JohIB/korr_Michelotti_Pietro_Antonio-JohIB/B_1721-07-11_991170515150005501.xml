<facsimile><graphic url="https://www.e-manuscripta.ch/i3f/v20/1079230/manifest"/></facsimile><text><body><div type="letter">
<pb facs="1079231" n="1"/>
  <opener><salute rend="center"><choice><abbr>Illustriss.<hi rend="sup">o</hi>imo</abbr><expan>Illustrissimo</expan></choice> atque <choice><abbr>Celeberr.<hi rend="sup">o</hi>imo</abbr><expan>Celeberrimo</expan></choice> Viro <choice><abbr>Jo:</abbr><expan>Johanni</expan></choice> <rs key="pers_DE-588-118509969" type="person">Bernoullio</rs>
      <lb/>Petrus Antonius <rs key="pers_DE-588-102552517" type="person">Michelottus</rs> <abbr>S. P. D.</abbr></salute></opener>
  <p><lb/>Hactenus expectavi frustra responsion<choice><orig><g ref="#em">ē</g></orig><reg>em</reg></choice> ad binas, quas ad
      <lb/>Te, Vir Doctissime, dedi <rs key="B_991170515150205501 B_991170515150105501" type="letter">Literas</rs>, demirorque in pr<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice>sentia
      <lb/>fascicul<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> ex binis mei <rs key="biblio_M3G2JA79" type="biblio">de separatione Fluidor<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> in Corpo<pc type="hyphenation">-</pc><lb break="no"/>re Animali</rs> operis exemplaribus compositum nondum
      <lb/>ad vos fuisse perlatum; pr<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice>sertim qu<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> ex Muliere No<pc type="hyphenation">-</pc><lb break="no"/>bilissima Marchione <rs type="person">Maria Loaysa Butintrochi</rs> Mediolanen<pc type="hyphenation">-</pc><lb break="no"/>si, ill<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> ips<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> fasciculum ante duos menses <rs key="place_GEO-3173435" type="place">Mediolano</rs>
      <lb/><rs key="place_GEO-2661604" type="place">Basileam</rs> fuisse miss<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice>, nuper intellexerim. Mense
      <lb/>pr<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice>terito <choice><abbr>Clariss.</abbr><expan>Clarissimus</expan></choice> Filius Tuus <rs key="pers_DE-588-117589144" type="person">Nicolaus</rs> salutem plurimam
      <lb/>tuo nomine, Inclyte Vir, mihi dixit, meque fecit certio<pc type="hyphenation">-</pc><lb break="no"/>rem, meas <rs key="B_991170515150205501 B_991170515150105501" type="letter">epistolas</rs>, in quibus de <choice><abbr>Illustriss.</abbr><expan>Illustrissimi</expan></choice> Viri <rs key="pers_DE-588-119543885" type="person"><choice><abbr>Jac.</abbr><expan>Jacobi</expan></choice> Ric<pc type="hyphenation">-</pc><lb break="no"/>cati</rs> demonstratione quad<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice>, pro veritate corollarii 2<choice><orig><g ref="#ndot">.</g></orig><reg/></choice> <choice><abbr>prop.</abbr><expan>propositionis</expan></choice>
      <lb/>37 eximii <rs key="biblio_6CP8LL78" type="biblio">libri</rs> <rs key="pers_DE-588-118587544" type="person">Newtoniani</rs> militante, verba feci, ad
      <lb/>Tuas pervenisse manus, itemque spem fecit, te cito ad
      <lb/>me scripturum de illa ipsa demonstratione,
      <lb/>quam nihil aliud esse putas, quam paralogismum
      <lb/>uti loquuntur. Scio me Tibi esse literis meis mult<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice>
      <lb/>admod<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> molestum, verumtamen tua incomparabili
      <lb/>benignitate fretus iterum audeo, Te etiam atque etiam
      <lb/>rogare, ut quamcitissime fieri poterit ad me mittas ra<pc type="hyphenation">-</pc><lb break="no"/>tiones omnes, quibus <choice><sic>convllli</sic><corr>convelli</corr></choice> possit <choice><abbr>Nobiliss.</abbr><expan>Nobilissimi</expan></choice> <rs key="pers_DE-588-119543885" type="person">Riccati</rs> ra<pc type="hyphenation">-</pc><lb break="no"/>tiocinatio, eamque pur<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> put<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> esse paralogismum
      <lb/>demonstrari. Me Tibi, propter maxim<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> quibus
      <lb/>me cumulasti gratiar<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> cumul<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice>, devinctissim<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> esse
<pb facs="1079232" n="2"/>
      <lb/>publice fassus sum semperque quamdiu fuero
      <lb/>fatebor: sin aut<choice><orig><g ref="#em">ē</g></orig><reg>em</reg></choice> ad hanc me<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice> epistolam<note type="comment" resp="SG">Die erbetene Kritik an der Beweisführung findet sich im <rs type="letter" key="B_991170515149905501">Brief</rs> vom 30. Juli 1721 (pp. 7–9).</note> quam
      <lb/>primum responderis, omniaque qu<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice> de vi
      <lb/>mot<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> aqu<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice> per foramen in fundo vasis factum
      <lb/>exilientis generante dici, aut cogitari possunt
      <lb/>adversus <rs key="biblio_6CP8LL78" type="biblio">Corollari<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice></rs> Newtonian<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice>, de quo supra
      <lb/>dicebam, mecum communicaveris, me Tibi in
      <lb/><choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice>ternum obligatissimum habebis.</p> <closer><salute>Vale, Vir <choice><abbr>Inge<pc type="hyphenation">-</pc><lb break="no"/>niosiss.<hi rend="sup">e</hi></abbr><expan>Ingeniosissime</expan></choice>, mihique respondere atque favere
      <lb/>ne dedigneris.</salute>
<dateline>Dab<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice> <rs key="place_GEO-3164603" type="place">Venetiis</rs> <choice><abbr>a.</abbr><expan>ante</expan></choice> <choice><abbr>d.</abbr><expan>diem</expan></choice> <date when="1721-07-11">11 Julii 1721.</date></dateline></closer>
  <postscript><p><lb/><choice><abbr>Clariss.<hi rend="sup">us</hi></abbr><expan>Clarissimus</expan></choice> Filius tuus <rs key="pers_DE-588-117589144" type="person">Nicolaus</rs> heri una cum Viro
        <lb/><choice><abbr>Ill.<hi rend="sup">o</hi></abbr><expan>Illustrissimo</expan></choice> atque <choice><abbr>Excell.<hi rend="sup">o</hi></abbr><expan>Excellentissimo</expan></choice> <rs key="pers_DE-588-121710742" type="person"><choice><abbr>Jo.</abbr><expan>Johanne</expan></choice> Vezzi</rs> hinc <rs key="place_GEO-3165243" type="place">Trident<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice></rs> versus
        <lb/>discessit ad potand<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice> aquam quandam mi<pc type="hyphenation">-</pc><lb break="no"/>neralem ex fonte Vallis cujusd<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice> <hi rend="u"><rs key="place_WEI-disole" type="place">del Sole</rs></hi> appellat<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice>
        <lb/>prosilientem, redibitque, uti spero, post mens<choice><orig><g ref="#em">ē</g></orig><reg>em</reg></choice>.
        <lb/>Si velis ad ill<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice> dare literas, eas ad me trans<pc type="hyphenation">-</pc><lb break="no"/><choice><sic>mitere</sic><corr>mittere</corr></choice> poteris; ego enim citissime illas ipsas
        <lb/>literas mitt<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice> <rs key="place_GEO-3165243" type="place">Trident<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice></rs><supplied>.</supplied></p></postscript>
<pb facs="1079233" n="3" type="empty"/>
<pb facs="1079234" n="4"/>
  <closer><address>
      <addrLine>A Monsieur</addrLine>
      <addrLine>Monsieur Jean Bernoull<choice><orig><g ref="#j">j</g></orig><reg>i</reg></choice></addrLine>
      <addrLine>Docteur en Medecine et Professeur <choice><sic>tre</sic><corr>tres</corr></choice></addrLine>
      <addrLine>Celebre de Matematique</addrLine>
      <addrLine><note type="postal">franca per <rs key="place_GEO-2775220" type="place">Insprug</rs>.</note>
                à <rs key="place_GEO-2661604" type="place">Basle</rs></addrLine>
    </address></closer>
</div></body></text></TEI>
