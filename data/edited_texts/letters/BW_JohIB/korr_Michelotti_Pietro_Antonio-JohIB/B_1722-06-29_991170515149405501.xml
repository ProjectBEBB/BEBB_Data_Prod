<facsimile><graphic url="https://www.e-manuscripta.ch/i3f/v20/1079290/manifest"/></facsimile><text><body><div type="letter">
<pb facs="1079291" n="1"/>
  <opener><salute><choice><abbr>Illustriss.<hi rend="sup">o</hi></abbr><expan>Illustrissimo</expan></choice> atque <choice><abbr>Celeberr.<hi rend="sup">o</hi></abbr><expan>Celeberrimo</expan></choice> Viro
      <lb/><choice><abbr>Jo:</abbr><expan>Johanni</expan></choice> Bernoullio <choice><abbr>P.</abbr><expan>Petrus</expan></choice> <choice><abbr>A.</abbr><expan>Antonius</expan></choice> Michelottus <abbr>S. P. D.</abbr></salute></opener>
  <p><lb/>Perveni h<choice><orig><g ref="#an">ā</g></orig><reg>an</reg></choice>c in Urbem simul cum Amplissi<pc type="hyphenation">-</pc><lb break="no"/>mis Celsissimi Senatus Veneti Legatis die
      <lb/>27 huius mensis sub meridi<choice><orig><g ref="#em">ē</g></orig><reg>em</reg></choice>, cogorque
      <lb/><rs key="place_GEO-2988507" type="place">Parisios</rs> contendere crastina die. H<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice>c causa
      <lb/>est propter qu<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice> ad istam vestr<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice> <rs key="place_GEO-2661604" type="place">Civitatem</rs>
      <lb/>Te, Vir Amicissime, salutatum venire haud
      <lb/>potui maximo cum meo moerore. Statim
      <lb/>ac Lutetiam <rs key="place_GEO-2988507" type="place">Parisiorum</rs> devenero, Te certior<choice><orig><g ref="#em">ē</g></orig><reg>em</reg></choice>
      <lb/>faciam, rogaboque ut tand<choice><orig><g ref="#em">ē</g></orig><reg>em</reg></choice> respondeas ad <rs key="B_991170515149605501" type="letter">meas
      <lb/>litteras</rs> pr<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice>terito Januario ad Te datas, super <choice><abbr>Illustr.</abbr><expan>Illustrissimi</expan></choice>
      <lb/><choice><abbr>C.</abbr><expan>Comitis</expan></choice> <rs key="pers_DE-588-119543885" type="person">Riccati</rs> nonnullis objectionibus. Meo in reditu
      <lb/>conabor istuc venire.</p> <closer><salute>Tu interim fac valeas
      <lb/>Vir <choice><abbr>Ingeniosiss.<hi rend="sup">e</hi></abbr><expan>Ingeniosissime</expan></choice> meque amare pergas.</salute> <dateline>Dab<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice>
      <lb/><rs key="place_GEO-2973783" type="place">Argentorati</rs> <choice><abbr>a.</abbr><expan>ante</expan></choice> <choice><abbr>d.</abbr><expan>diem</expan></choice> 29 Junii 1722.</dateline></closer>
  <postscript><p>P. S. <choice><abbr>Illustriss.<hi rend="sup">o</hi></abbr><expan>Illustrissimo</expan></choice> Viro Agnato Tuo <rs key="pers_DE-588-119166895" type="person">Nicolao</rs>, uti
        <lb/>et Clarissimis Filiis Tuis <rs key="pers_DE-588-117589144" type="person">Nicolao</rs>, et <rs key="pers_DE-588-118656503" type="person">Danieli</rs>,
        <lb/>ut salut<choice><orig><g ref="#em">ē</g></orig><reg>em</reg></choice> plurimam meo nomine dicas, Te
        <lb/>etiam atque eti<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice> rogo.</p></postscript>
