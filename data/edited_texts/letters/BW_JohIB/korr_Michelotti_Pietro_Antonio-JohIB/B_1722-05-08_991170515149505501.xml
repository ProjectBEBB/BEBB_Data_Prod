<facsimile><graphic url="https://www.e-manuscripta.ch/i3f/v20/1079282/manifest"/></facsimile><text><body><div type="letter">
<pb facs="1079283" n="1"/>
  <opener><salute>Illustrissimo atque <choice><abbr>Celeberr.<hi rend="sup">o</hi></abbr><expan>Celeberrimo</expan></choice> Viro <choice><abbr>Jo:</abbr><expan>Johanni</expan></choice> <rs key="pers_DE-588-118509969" type="person">Bernoull<choice><orig><g ref="#j">j</g></orig><reg>i</reg></choice></rs>
      <lb/>Petrus Antonius <rs key="pers_DE-588-102552517" type="person">Michelottus</rs> <abbr>S. P. D.</abbr></salute></opener>
  <p><lb/>Maximo dolore affectus sum protinus ac ex Clarissimo Filio
      <lb/>tuo <rs key="pers_DE-588-117589144" type="person">Nicolao</rs> intellexi, Te ideo ad <rs key="B_991170515149605501" type="letter">meas literas</rs> hactenus non
      <lb/>respondisse, quod adversa valetudine continuo fueris conflictatus.
      <lb/>Te in pr<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice>sentia sanum esse, ac bene valere mihi per<pc type="hyphenation">-</pc><lb break="no"/>suadeo, ac propterea brevi ad <rs key="B_991170515149605501" type="letter">meas literas</rs> ad Te pr<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice>terito
      <lb/>mense Januarii datas responsur<choice><orig><g ref="#um">ū</g></orig><reg>um</reg></choice>. Ego hinc discessurus
      <lb/>sum die 26 huius mensis <rs key="place_GEO-2988507" type="place">Parisios</rs> profecturus. Quare
      <lb/>si aliquas literas ad me daturus est, expecta, qu<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice>so,
      <lb/>quoad Te certiorem faciam, me <rs key="place_GEO-2988507" type="place">Parisios</rs> pervenisse,
      <lb/>qu<choice><orig><g ref="#ograv">ò</g></orig><reg>o</reg></choice> statim ac advenero scrib<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice> ad Te, Vir Illustrissime,
      <lb/>ibique perlibenter responsion<choice><orig><g ref="#em">ē</g></orig><reg>em</reg></choice> aliqu<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice> ad meas <rs key="B_991170515149605501" type="letter">lite<pc type="hyphenation">-</pc><lb break="no"/>ras</rs> supra commemoratas accipiam. Clarissimus <rs key="pers_DE-588-117589144" type="person">Filius
      <lb/>tuus</rs> etiam discessurus est sub fin<choice><orig><g ref="#em">ē</g></orig><reg>em</reg></choice> huius mensis, dum<pc type="hyphenation">-</pc><lb break="no"/>modo tamen <choice><abbr>Excell.<hi rend="sup">us</hi></abbr><expan>Excellentissimus</expan></choice> <rs key="pers_DE-588-121710742" type="person">Vezzi</rs> ipsum non impediat. Si h<choice><orig><g ref="#ihat">î</g></orig><reg>i</reg></choice>c
      <lb/>remanebit, domi me<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice> habitabit, quousque huc ego re<pc type="hyphenation">-</pc><lb break="no"/>vertar.</p>
  <closer><salute>Vale, Vir Sapientissime, meque amare perge.</salute>
      <lb/><dateline><choice><abbr>D.</abbr><expan>Dabam</expan></choice> <rs key="place_GEO-3164603" type="place">Venetiis</rs> <choice><abbr>a. d.</abbr><expan>ad diem</expan></choice> <date when="1722-05-08">8 Maii 1722.</date></dateline></closer>
<pb facs="1079284" n="2" type="empty"/>
<pb facs="1079285" n="3" type="empty"/>
<pb facs="1079286" n="4"/>
  <closer><address>
      <addrLine>A Monsieur</addrLine>
      <addrLine>Monsieur Jean Bernoull<choice><orig><g ref="#j">j</g></orig><reg>i</reg></choice></addrLine>
      <addrLine>Docteur en Medecine, et Professeur</addrLine>
      <addrLine>tres celebre de Matematique</addrLine>
      <addrLine><note type="postal">franca <choice><orig><g ref="#per">&#42833;</g></orig><reg>per</reg></choice> <rs key="place_GEO-2775220" type="place">Insprug</rs></note>
                à <rs key="place_GEO-2661604" type="place">Basle</rs></addrLine>
    </address></closer>
