<div type="letter">
<pb facs="https://www.e-manuscripta.ch/i3f/v20/3698508/canvas/3698509" type="archival"/>
<pb facs="https://www.e-manuscripta.ch/i3f/v20/3698508/canvas/3698510" type="archival"/>
<pb facs="https://www.e-manuscripta.ch/i3f/v20/3698508/canvas/3698511" type="archival"/>
<pb facs="https://www.e-manuscripta.ch/i3f/v20/3698508/canvas/3698512" type="archival"/>
