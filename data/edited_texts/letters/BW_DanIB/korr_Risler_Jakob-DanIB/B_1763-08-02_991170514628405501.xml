      <addrLine>Monsieur</addrLine>
      <addrLine>Monsieur <rs key="pers_DE-588-118656503" type="person">Daniel Bernoull<choice><orig><g ref="#j">j</g></orig><reg>i</reg></choice></rs></addrLine>
