<body>
<div type="letter">



<pb facs="1063807" n="1"/>
  <opener><salute rend="center"><lb/>Viro Celeberrimo
      <lb/><rs key="pers_DE-588-119166895" type="person">Nicolao Bernoullio</rs>
      <lb/><abbr>S. P. D.</abbr>
      <lb/><rs key="pers_DE-588-118783181" type="person"><abbr>Jo.</abbr> Burck. Menckenius</rs></salute></opener>
  <p><lb/>Honoratissimum <rs key="pers_DE-588-118509969" type="person">Patruum</rs> Tuum quem
      <lb/>plurimum salutabis meo nomine
      <lb/>hactenus <choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice>grotare magnopere doleo,
      <lb/>toto<choice><orig><g ref="#que">&#xe8bf;</g></orig><reg>que</reg></choice> pectore precor, ut quamprimum
      <lb/>penitus convalescat, diu<choice><orig><g ref="#que">&#xe8bf;</g></orig><reg>que</reg></choice> rebus mortalibus
      <lb/>intersit. <rs type="letter">Responsionem</rs> Tuam proxime
      <lb/><rs type="biblio">Actis</rs> inseram, quanquam admodum ve<pc type="hyphenation">-</pc><lb break="no"/>reor, ne <rs type="person">Itali</rs> me rursus fatigent sche<pc type="hyphenation">-</pc><lb break="no"/>diasmatibus suis, qu<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice> <rs type="biblio">Actis</rs> inserio cupiunt.
      <lb/>Misit ad me <rs key="pers_DE-588-120089807" type="person">Rizzetus</rs> duas prolixas
<pb facs="1063808" n="2"/>
      <lb/>dissertationes, quas vocat Anti-Ber<pc type="hyphenation">-</pc><lb break="no"/>noullianas, alteram <rs type="biblio">de arte conjectandi
      <lb/>ad aleas applicata</rs>, alteram <rs type="biblio">de refracti<pc type="hyphenation">-</pc><lb break="no"/>one luminis, qua refractionis natura
      <lb/>explicatur</rs>; quas cum diu tergiversa<pc type="hyphenation">-</pc><lb break="no"/>tus essem <rs type="biblio">Actis</rs> inserere (ne<choice><orig><g ref="#que">&#xe8bf;</g></orig><reg>que</reg></choice> enim
      <lb/>adhuc in illis comparent) excitavit
      <lb/>is, quod mireris, <rs type="person">patronos</rs> in aula
      <lb/>impetravit<choice><orig><g ref="#que">&#xe8bf;</g></orig><reg>que</reg></choice> mandatum Regium, quo
      <lb/>observata illa <rs type="biblio">Actis</rs> interserere jubeamur
      <lb/>passus tamen est, omitti appendices, quas
      <lb/>adjecerat Satyra plenas. Nobis cum pa<pc type="hyphenation">-</pc><lb break="no"/>rendi gloria relicta sit, non gravabimi<pc type="hyphenation">-</pc><lb break="no"/>ni h<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice>c legere dein<del><gap/></del><add>c</add>eps novis<choice><orig><g ref="#que">&#xe8bf;</g></orig><reg>que</reg></choice> adeo theatrum aperiri in <rs type="person">Actis</rs>
      <lb/>nostris, a quib<choice><orig><g ref="#us">[us]</g></orig><reg>us</reg></choice> maxime quidem abhorremus.</p>
  <closer><lb/><salute>Vale.</salute> <lb/><dateline><abbr>Dab.</abbr> <rs key="place_GEO-2879139" type="place">Lipsi<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice></rs> <abbr>d.</abbr> <date when="1716-05-18">18 Maji 1726</date>.</dateline>
<pb facs="1063809" n="3" type="empty"/>
