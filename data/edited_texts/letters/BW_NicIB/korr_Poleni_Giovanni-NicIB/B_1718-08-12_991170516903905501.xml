<body>
<div type="letter">
<pb facs="1362053" n="1"/>
  <opener><choice><abbr>Ill.<hi rend="sup">mo</hi></abbr><expan>Illustrissimo</expan></choice> <choice><abbr>S.<hi rend="sup">e</hi></abbr><expan>Signore</expan></choice> <choice><abbr>S.<hi rend="sup">e</hi></abbr><expan>Signore</expan></choice> <choice><abbr>Prne</abbr><expan>Patrone</expan></choice> <choice><abbr>Colmo</abbr><expan>Colendissimo</expan></choice>
      <lb/><dateline><rs key="place_GEO-3171728" type="place"><abbr>Pad.<hi rend="sup">a</hi></abbr></rs> <date when="1718-08-12">12 <abbr>Ag.<hi rend="sup">o</hi></abbr> 1718</date></dateline></opener>
  <p><lb/>Non potendo star quieto in <rs type="place">villa</rs>
      <lb/>sono ritornato in <rs type="place" key="place_GEO-3171728">città</rs>, risservando
      <lb/>all’<date when="1719">anno venturo</date> il restante della
      <lb/>villegiatura. Mi capita l’<rs type="letter">occlusa</rs>
      <lb/>di <choice><abbr>V<supplied>.</supplied></abbr><expan>Vostra</expan></choice> <choice><abbr>S<supplied>.</supplied></abbr><expan>Signoria</expan></choice> <choice><abbr>Ill.<hi rend="sup">ma</hi></abbr><expan>Illustrissima</expan></choice>, glela trasmetto i<choice><orig><g ref="#mm">&#xE5D2;</g></orig><reg>mm</reg></choice>ediate.
      <lb/>Ella mi conservi la sua grazia:
      <lb/>riverisca in mio nome l’<abbr>Ill.<hi rend="sup">mo</hi></abbr>
      <lb/><rs key="pers_DE-588-102552517" type="person">Michelotti</rs>, <unclear>e</unclear> si compiaccia addimandargli
      <lb/>se dal <abbr>S.<hi rend="sup">r</hi></abbr> <rs key="pers_DE-588-1037587715" type="person">Ertz</rs> abbia ricevuto un
      <lb/>mio <rs type="biblio" key="biblio_KGKQAP5S">libro</rs>: mi creda</p>
  <closer>Di <choice><abbr>V<supplied>.</supplied></abbr><expan>Vostra</expan></choice> <choice><abbr>S<supplied>.</supplied></abbr><expan>Signoria</expan></choice> <choice><abbr>Ill.<hi rend="sup">ma</hi></abbr><expan>Illustrissima</expan></choice>
      <lb/><choice><abbr>Di.<hi rend="sup">mo</hi></abbr><expan>Divotissimo</expan></choice> <choice><abbr>Obbl.<hi rend="sup">mo</hi></abbr><expan>Obbligatissimo</expan></choice> <choice><abbr>ser.<hi rend="sup">re</hi></abbr><expan>servitore</expan></choice> <choice><abbr>v.<hi rend="sup">o</hi></abbr><expan>vero</expan></choice>
      <lb/><rs key="pers_DE-588-11887733X" type="person">Giovanni Poleni</rs></closer>
  <postscript><p><abbr>P. S.</abbr>
        <lb/>vedrò volentieri due sue
        <lb/>righe; mà in italiano.</p></postscript>
<pb facs="1362055" n="2" type="empty"/>
</div>
</body>
</text></TEI>