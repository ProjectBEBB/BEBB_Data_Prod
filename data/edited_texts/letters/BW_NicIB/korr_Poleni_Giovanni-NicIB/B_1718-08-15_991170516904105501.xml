<body>
<div type="letter">
<pb facs="1362041" n="1"/>
  <opener><salute><abbr>Ill.<hi rend="sup">mo</hi></abbr> <abbr>S.<hi rend="sup">e</hi></abbr> <abbr>S.<hi rend="sup">e</hi></abbr> <choice><abbr>P<supplied>.</supplied>rone</abbr><expan>Patrone</expan></choice> <choice><abbr>Col<supplied>.</supplied>mo</abbr><expan>Colendissimo</expan></choice></salute></opener>

  <p><lb/>Hò dati al <abbr>S.<hi rend="sup">r</hi></abbr> <rs key="pers_DE-588-1037587715" type="person">Ertz</rs> cinque esemplari del
      <lb/>mio <abbr>Lib.<hi rend="sup">o</hi></abbr> <rs type="biblio" key="biblio_KGKQAP5S">de Castellis</rs>, quatro per lui,
      <lb/>et uno <choice><orig><g ref="#per">&#42833;</g></orig><reg>per</reg></choice> l’<abbr>Ill.<hi rend="sup">mo</hi></abbr> <rs key="pers_DE-588-102552517" type="person">Michelotti</rs><choice><orig>:</orig><reg>;</reg></choice> prego
      <lb/>adunque lo stesso <abbr>S.<hi rend="sup">r</hi></abbr> <rs key="pers_DE-588-102552517" type="person">Michelotti</rs>
      <lb/>ricuperarselo, e riceverlo <choice><orig><g ref="#per">&#42833;</g></orig><reg>per</reg></choice> un attestato
      <lb/>del mio rispetto. Il <abbr>S.<hi rend="sup">r</hi></abbr> <rs type="person" key="pers_DE-588-136541146X">Martini</rs> le
      <lb/>spedirà subito la Theriaca<choice><orig>:</orig><reg>;</reg></choice> con essa
      <lb/>due de’ miei <rs type="biblio" key="biblio_KGKQAP5S">Libri</rs>; uno <choice><orig><g ref="#per">&#42833;</g></orig><reg>per</reg></choice> i<add>l</add> <abbr>S.<hi rend="sup">r</hi></abbr>
      <lb/><rs key="pers_DE-588-119062372" type="person">Varignon</rs><supplied>,</supplied> l’altro <choice><orig><g ref="#per">&#42833;</g></orig><reg>per</reg></choice> il <abbr>S.<hi rend="sup">r</hi></abbr> <add>de</add> <rs key="pers_DE-588-117601020" type="person">Mon<add>mo</add>rt</rs>. <choice><orig>Giacche</orig><reg>Giacché</reg></choice>
      <lb/>la famiglia <rs key="GND GND" type="person">Bernoulli</rs> mi è benefica;
      <lb/>mi procuri <choice><abbr>V<supplied>.</supplied></abbr><expan>Vostra</expan></choice> <choice><abbr>S<supplied>.</supplied></abbr><expan>Signoria</expan></choice> <choice><abbr>Ill.<hi rend="sup">ma</hi></abbr><expan>Illustrissima</expan></choice> anco questa
      <lb/>trasmissione, facendomi grazia di far
      <lb/>specificare à cotesti due signori in
      <lb/>buona frase francese, che mando loro
      <lb/>questi <rs type="biblio" key="biblio_KGKQAP5S">Libri</rs> in attestato del mio vero
<pb facs="1362043" n="2"/>rispetto. Del resto il mio viaggio è
      <lb/>sotto conditione, <foreign xml:lang="lat">si <rs type="person">ille</rs> sit apud batavos</foreign>,
      <lb/>se si adempirà la conditione, io non
      <lb/>macherò al viaggio; <foreign xml:lang="lat">tunc, Di<choice><orig><g ref="#j">j</g></orig><reg>i</reg></choice> optumum<supplied>.</supplied></foreign>
      <lb/>Io non hò altro di buono, che la
      <lb/>costanza, come sono costantissimo nell’
      <lb break="no"/>essere</p>
  <p>Di <choice><abbr>V<supplied>.</supplied></abbr><expan>Vostra</expan></choice> <choice><abbr>S<supplied>.</supplied></abbr><expan>Signoria</expan></choice> <choice><abbr>Ill.<hi rend="sup">ma</hi></abbr><expan>Illustrissima</expan></choice> (cui
      <lb/>raccomando di nuovo li
      <lb/><rs type="biblio" key="biblio_KGKQAP5S">Libri</rs> <choice><orig><g ref="#per">&#42833;</g></orig><reg>per</reg></choice> li <abbr>S.<hi rend="sup">ri</hi></abbr> di <rs key="pers_DE-588-117601020" type="person">Monmort</rs>,
      <lb/>e <rs key="pers_DE-588-119062372" type="person">Varignon</rs>)</p>

  <closer><lb/><salute><choice><abbr>Div.<hi rend="sup">mo</hi></abbr><expan>Divotissimo</expan></choice> <choice><abbr>Obbl.<hi rend="sup">mo</hi></abbr><expan>Obbligatissimo</expan></choice> <choice><abbr>se.<hi rend="sup">r</hi></abbr><expan>servitor</expan></choice> <choice><abbr>v.<hi rend="sup">o</hi></abbr><expan>vero</expan></choice></salute>
      <lb/><signed><rs key="pers_DE-588-11887733X" type="person">Giovanni Poleni</rs></signed></closer>

  <note hand="pers_DE-588-119166895"><foreign xml:lang="ger"><abbr>Empf.</abbr> den <date when="1718-08-16">16.<hi rend="sup">ten</hi> <abbr>Aug.</abbr> 1718</date>.</foreign></note>
</div>
