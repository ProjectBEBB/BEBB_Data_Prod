<body>
<div type="letter">
<pb facs="1362029" n="1"/>
  <opener><abbr>Ill.<hi rend="sup">mo</hi></abbr> <abbr>sig.<hi rend="sup">re</hi></abbr> <abbr>sig.<hi rend="sup">re</hi></abbr> <choice><abbr>P<supplied>.</supplied>ne</abbr><expan>Padrone</expan></choice> <choice><abbr>Col.mo</abbr><expan>Colendissimo</expan></choice></opener>
  <p><lb/>Supponendola arrivata felicemente à <rs key="place_GEO-3164603" type="place">Venezia</rs>
      <lb/>me ne consolo con tutto il cuore, e La prego
      <lb/>con la presente della continuazione del di Lei
      <lb/>à me preziosissimo amore. Nel tempo stesso
      <lb/>mi sarà sommo favore, ch’ella mandi
      <lb/>il <rs type="biblio">Libro</rs>, ch’io li ho consegnato a<unclear>ll</unclear>’<abbr>Ill.<hi rend="sup">ma</hi></abbr> <abbr>March.<hi rend="sup">a</hi></abbr>
      <lb/><rs type="person">Eugenia Poleni Boza</rs>, che stà alli Teatini<note type="comment">Die im Theatinerkloster San Nicolò da Tolentino in Venedig residierende Marchesa Eugenia Poleni Boza konnte nicht identifiziert werden.</note>
      <lb/>al <rs key="GeoNamesID" type="place">ponte del Gaffaro</rs>, scusando il disturbo,
      <lb/>et onorandomi subito; ne essendovi quì
      <lb/>novità alcuna di rimarco, mio <rs type="person" key="pers_DE-588-1365357775">Padre</rs> pure
      <lb/>La riverisce <abbr>divot.<hi rend="sup">e</hi></abbr>, come facc’io l’<abbr>Ill.mo</abbr>
      <lb/><rs key="pers_DE-588-102552517" type="person">Michelotti</rs>, e con tutta l’<abbr>attent.<hi rend="sup">e</hi></abbr> <unclear>di</unclear> <unclear><gap/></unclear>
      <lb/>sempre più, mi <abbr>prot.<hi rend="sup">o</hi></abbr> con tutto rispetto</p>
  <closer><lb/><abbr>Ill.<hi rend="sup">mo</hi></abbr>
      <lb/><abbr>Dev.<hi rend="sup">mo</hi></abbr> <abbr>Obbl.<hi rend="sup">mo</hi></abbr> <abbr>ser<supplied>.</supplied><hi rend="sup">e</hi></abbr> <choice><abbr>v.<hi rend="sup">o</hi></abbr><expan>vero</expan></choice>
      <lb/><rs key="pers_DE-588-11887733X" type="person">Giovanni Poleni</rs>
      <lb/><dateline><rs key="place_GEO-3171728" type="place"><abbr>Pad.<hi rend="sup">a</hi></abbr></rs> <date when="1718-02-25">1717/8<choice><orig><g ref="#nddot">:</g></orig><reg/></choice> 25 <abbr>Feb.<hi rend="sup">o</hi></abbr></date></dateline></closer>
  <note hand="pers_DE-588-119166895"><foreign xml:lang="ger"><choice><abbr>Empf.</abbr><expan>Empfangen</expan></choice> den <date when="1717-09-26">26.<hi rend="sup">ten</hi></date></foreign></note>
<pb facs="1362030" n="2" type="empty"/>
