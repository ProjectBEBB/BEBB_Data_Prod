<div type="letter">
<pb facs="1362047" n="1"/>
  <opener><salute><abbr>Ill.<hi rend="sup">mo</hi></abbr> <abbr>S.<hi rend="sup">e</hi></abbr>, et Amico <choice><abbr>Rive.<hi rend="sup">mo</hi></abbr><expan>Riveritissimo</expan></choice></salute></opener>
  <p><lb/>Gran carestia delle sue lettere. Due righe
      <lb/>mi bastano italiane, ò francesi, ò latine,
      <lb/>ò anco tedesche, che li nostri segreti
      <lb/>non ricusano l’Interprete. E di tutto
      <lb/>cuore la riverisco.</p>
<note hand="pers_DE-588-119166895"><foreign xml:lang="ger"><abbr>Empfn.</abbr> und <abbr>beantw.</abbr> den 22.<hi rend="sup">ten</hi> Augst 1718</foreign></note>
<pb facs="1362048" n="2" type="empty"/>
<note hand="unknown">Poleni 22 Aug. 18.</note>
</div>
