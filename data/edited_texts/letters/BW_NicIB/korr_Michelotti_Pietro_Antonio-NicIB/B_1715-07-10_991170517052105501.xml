<pb facs="1038323" n="132r"/>
  <opener>
      <salute rend="center"><lb/><del>Domino </del><rs key="pers_DE-588-102552517" type="person">Petro Antonio Michelotti</rs>
      <lb/><abbr>S. P. D.</abbr> <rs key="pers_DE-588-119166895" type="person"><abbr>N. B.</abbr></rs></salute>
  </opener>
  <p>
      <lb/>Accepimus transmissa<del> <choice><orig><g ref="#agrav">à</g></orig><reg>a</reg></choice> Te</del> nobis <choice><orig><g ref="#agrav">à</g></orig><reg>a</reg></choice> Te folia <rs type="keyword">Diarii Italici</rs>, quibus
      <lb/>continentur a<choice><orig><g ref="#nn">n̄</g></orig><reg>nn</reg></choice>otationes me<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice> in <abbr>Ill.</abbr> <abbr>D.</abbr> Comitis <rs key="pers_DE-588-109091766X" type="person">Riccati</rs> <rs type="biblio" key="biblio_6MW47K34">Schediasma</rs>
      <lb/><choice><orig><g ref="#agrav">à</g></orig><reg>a</reg></choice> Te su<choice><orig><g ref="#mm">&#xE5D2;</g></orig><reg>mm</reg></choice>a diligentia in Italicam linguam vers<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice>. Maxim<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice> Tibi <choice><orig><g ref="#agrav">à</g></orig><reg>a</reg></choice> me
      <lb/>debentur grati<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice>, quod molestum hunc laborem inter tot negotia
      <lb/>in Te suscipere dignatus fueris; <subst><del>g</del><add>G</add></subst>ratus hinc agnosco Tuam erga nos
      <lb/>me cumprimis benevolentiam et favorem<unclear>,</unclear> hoc Tuo favore fretus
      <lb/>audeo et hunc Tibi imponere laborem ut nisi molestum fuerit
      <lb/>et si co<choice><orig><g ref="#mm">&#xE5D2;</g></orig><reg>mm</reg></choice>ode fieri possit sequentes errores Typographicos, qui quidem
      <lb/>ob <subst><del>sc</del><add>ex</add></subst>actissimam <add>in versione<del>mei sch</del> et correctione etiam procul dubio <rs type="biblio" key="biblio_6MW47K34">Schediasmatis</rs> mei</add> <choice><orig><g ref="#agrav">à</g></orig><reg>a</reg></choice> Te adhibitam diligentiam <choice><orig>|:</orig><reg>(</reg></choice>pro qua etiam
<pb facs="1038324" n="132v"/>
      <lb/>gratias ago<choice><orig>:|</orig><reg>)</reg></choice> pauci sunt, corrigendos dare velis. <abbr>Pag.</abbr> 320<choice><orig><choice><orig><g ref="#ndot">.</g></orig><reg/></choice></orig><reg>,</reg></choice> <choice><abbr>l.</abbr><expan>linea</expan></choice> 10<choice><orig><choice><orig><g ref="#ndot">.</g></orig><reg/></choice></orig><reg>,</reg></choice>
      <lb/>pro <formula>-ddx\sqrt{xx+yy}</formula> <choice><abbr>l.</abbr><expan>lege</expan></choice> <formula>\frac{-ddx\sqrt{xx+yy}}{x}</formula>. <abbr>Pag.</abbr> 322<choice><orig><choice><orig><g ref="#ndot">.</g></orig><reg/></choice></orig><reg>,</reg></choice> <choice><abbr>l.</abbr><expan>linea</expan></choice> 21<choice><orig><g ref="#ndot">.</g></orig><reg/></choice> <quote><hi rend="u">che si muti la
      <lb/>specie della curva</hi></quote>, omissa est particula negativa <hi rend="u">non</hi>: <abbr>Pag.</abbr> 327<choice><orig><choice><orig><g ref="#ndot">.</g></orig><reg/></choice></orig><reg>,</reg></choice>
      <lb/><choice><abbr>l.</abbr><expan>linea</expan></choice> 2<choice><orig><g ref="#ndot">.</g></orig><reg/></choice> pro <formula>CMX</formula> <choice><abbr>l.</abbr><expan>lege</expan></choice> <formula>CMx</formula>. <abbr>Pag.</abbr> 333<choice><orig><choice><orig><g ref="#ndot">.</g></orig><reg/></choice></orig><reg>,</reg></choice> <choice><abbr>l.</abbr><expan>linea</expan></choice> <abbr>ult.</abbr> pro <formula>+4aahhxxyy</formula> <choice><abbr>l.</abbr><expan>lege</expan></choice>
      <lb/><formula>-4aahhxxyy</formula><choice><orig><choice><orig><g ref="#ndot">.</g></orig><reg/></choice></orig><reg>,</reg></choice> <abbr>pag.</abbr> 336<choice><orig><choice><orig><g ref="#ndot">.</g></orig><reg/></choice></orig><reg>,</reg></choice> <choice><abbr>l.</abbr><expan>linea</expan></choice> 23<choice><orig><g ref="#ndot">.</g></orig><reg/></choice> pro 1703 <choice><abbr>l.</abbr><expan>lege</expan></choice> 1713. <abbr>Pag.</abbr> 339<choice><orig><choice><orig><g ref="#ndot">.</g></orig><reg/></choice></orig><reg>,</reg></choice> <choice><abbr>l.</abbr><expan>linea</expan></choice> 6<choice><orig><g ref="#ndot">.</g></orig><reg/></choice> pro
      <lb/><formula>f=z^{-2}</formula> <choice><abbr>l.</abbr><expan>lege</expan></choice> <formula>f=z</formula>. <abbr>Ibid.</abbr> <choice><abbr>l.</abbr><expan>linea</expan></choice> 17<choice><orig><g ref="#ndot">.</g></orig><reg/></choice> pro <formula>LJ</formula><choice><orig><g ref="#ndot">.</g></orig><reg/></choice> <choice><abbr>l.</abbr><expan>lege</expan></choice> <formula>Ll</formula><choice><orig><choice><orig><g ref="#ndot">.</g></orig><reg/></choice></orig><reg>,</reg></choice> <abbr>pag.</abbr> 340<choice><orig><choice><orig><g ref="#ndot">.</g></orig><reg/></choice></orig><reg>,</reg></choice> <choice><abbr>l.</abbr><expan>linea</expan></choice> 4<choice><orig><choice><orig><g ref="#ndot">.</g></orig><reg/></choice></orig><reg>,</reg></choice><del> l.</del> pro
      <lb/><formula>\int\frac{pt\,dt}{\sqrt{aa-tt}}</formula> <choice><abbr>l.</abbr><expan>lege</expan></choice> <formula>\int\frac{pt\,dt}{\sqrt{hh-tt}}</formula><choice><orig><choice><orig><g ref="#ndot">.</g></orig><reg/></choice></orig><reg>,</reg></choice> <abbr>pag.</abbr> 342<choice><orig><choice><orig><g ref="#ndot">.</g></orig><reg/></choice></orig><reg>,</reg></choice> <choice><abbr>l.</abbr><expan>linea</expan></choice> 23<choice><orig><choice><orig><g ref="#ndot">.</g></orig><reg/></choice></orig><reg>,</reg></choice> <foreign xml:lang="ita"><hi rend="u">mostrerò</hi></foreign> pro futuro poni debet
      <lb/>pr<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice>teritum<choice><orig>.</orig><reg>,</reg></choice> <abbr>pag.</abbr> 349<choice><orig><choice><orig><g ref="#ndot">.</g></orig><reg/></choice></orig><reg>,</reg></choice> <choice><abbr>l.</abbr><expan>linea</expan></choice> 25<choice><orig><g ref="#ndot">.</g></orig><reg/></choice> pro <formula>+CB</formula><choice><orig><g ref="#ndot">.</g></orig><reg/></choice> <choice><abbr>l.</abbr><expan>lege</expan></choice> <formula>+GB</formula>. <abbr>Pag.</abbr> 350<choice><orig><choice><orig><g ref="#ndot">.</g></orig><reg/></choice></orig><reg>,</reg></choice> <choice><abbr>l.</abbr><expan>linea</expan></choice> <abbr>ult.</abbr> pro
      <lb/><formula>\frac{4acc}{b-a}</formula> <choice><abbr>l.</abbr><expan>lege</expan></choice> <formula>\frac{4acc}{bb}</formula>. <rs key="pers_DE-588-118509969" type="person">Patruus</rs> meus qui plurimam salutem Tibi
      <lb/>impertitur rogat ut sibi veniam des, quod per quam plurima
      <lb/>negotia et munia Academica noviter ipsi delata impeditus nullas
      <lb/>responsiones super Problematibus qu<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice> ipsi proposuisti mittere
      <lb/>potest. Quod dubium Tuum attinet circa modum quo fiunt
      <lb/>secretiones in glandulis, me Tibi scribere jussit ut <rs key="biblio_J5VTJD6V" type="biblio">legas ea</rs> qu<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice> <abbr>D.</abbr>
      <lb/><rs key="pers_DE-588-100703828" type="person">Winslow</rs> Socius <rs type="organisation" key="org_DE-588-35019-9">Academi<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice> Gallic<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice></rs> publicavit in Co<choice><orig><g ref="#mm">&#xE5D2;</g></orig><reg>mm</reg></choice>entariis
      <lb/>Academicis Anni 1711<choice><orig><g ref="#ndot">.</g></orig><reg/></choice><del> publicavit</del> ubi plane eandem sententi<choice><orig><g ref="#am">ā</g></orig><reg>am</reg></choice>
      <lb/><add>quam </add>fovet<del> quod</del> <rs key="pers_DE-588-118509969" type="person">Patruus</rs> meus fusius explicat supponitque quod glan<pc type="hyphenation">-</pc><lb break="no"/>dul<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice> in ipsa prima formatione liquore suo particulari jam imbu<pc type="hyphenation">-</pc><lb break="no"/>t<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice> fuerint <choice><orig><g ref="#agrav">à</g></orig><reg>a</reg></choice> Sapientissimo nostro Creatore eodem <subst><del>tempore</del><add>modo</add></subst> quo
      <lb/>reliqu<subst><del>orum</del><add><unclear>as</unclear></add></subst> <del>nostri membrorum</del> nostr<subst><del>a</del><add>i</add></subst><del> sunt</del> corporis partes pri<pc type="hyphenation">-</pc><lb break="no"/>mum format<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice> fuerunt. Quod officia Tua pro <rs type="organisation">Cathedra Mathe<pc type="hyphenation">-</pc><lb break="no"/>matica <rs key="place_GEO-3171728" type="place">Patavina</rs></rs> mihi<metamark/> <add><choice><orig>|:</orig><reg>(</reg></choice>siquidem <rs key="pers_DE-588-118509969" type="person">Patruus</rs> <add>ob recusatum ipsi petitum salarium</add> hic manere constituit<choice><orig>:|</orig><reg>)</reg></choice></add> impetranda apud <abbr>Ill.</abbr> et <abbr>Excell.</abbr> Tuos
      <lb/>Mecoenatas interponere non cessas, su<choice><orig><g ref="#mm">&#xE5D2;</g></orig><reg>mm</reg></choice>as habeo gratias
      <lb/><del>rogo</del><del>opto </del>rogo tantum
      <lb/><del>ut </del>ut cito significes quid spei supersit, opto enim vehementer
      <lb/>ut negotium hoc quamprimum finiat.</p> <closer><salute>Vale Vir Excellentissime
      <lb/><del>mihique </del>meque amare perge.</salute> <dateline>Dabam <rs key="place_GEO-2661604" type="place">Basile<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice></rs> 10. Julij 1715.</dateline></closer>
  <postscript>
    <p>
        <lb/><abbr>P. S.</abbr> <abbr>D.</abbr> <rs key="pers_DE-588-120379260" type="person">Scheuchzerus</rs> ex Italico itinere in <rs key="place_VER-schweiz" type="place">Patriam</rs> redux <rs key="B_991170515093405501" type="letter">literas</rs> <rs key="pers_DE-588-118509969" type="person">Patrui</rs> mei
        <lb/>quas ipsi <rs key="place_GEO-3169070" type="place">Romam</rs> misisse Te nobis nuntiaveras, se non accepisse nobis scripsit.
    </p>
  </postscript>
