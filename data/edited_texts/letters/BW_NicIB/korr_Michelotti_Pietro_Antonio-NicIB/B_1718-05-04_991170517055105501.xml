<body>
<div type="letter">
<pb facs="1038425" n="147v"/>
  <p>
      <lb/><rs key="B_991170517055505501" type="letter">Responsionem</rs> ad <rs key="B_991170517055405501" type="letter">priorem</rs> Epistol<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice> Tu<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice> <choice><abbr>d.</abbr><expan>die</expan></choice> <date>2. Mai<choice><orig><g ref="#j">j</g></orig><reg>i</reg></choice></date> ad me
      <lb/>dat<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice> partem jam dedi in <rs key="B_991170517055505501" type="letter">epistola</rs> mea eadem die ad Te
      <lb/>missa, quamque Te <date when="1718-05-03">heri</date> pariter accepisse spero. Quod
      <lb/>attinet ad demonstrationem<del> Theorem</del>, quam petis in po<pc type="hyphenation">-</pc>
<pb facs="1038426" n="148r"/>
      <lb break="no"/>steriore <rs key="B_991170517055405501" type="letter">epistol<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice></rs> Tu<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice> parte, Theorematis illius Hydrostatici,
      <lb/>quod omnia fluida (homogenea) premant superficiem continen<pc type="hyphenation">-</pc><lb break="no"/>tem perpendiculariter in quovis puncto in ratione altitudi<pc type="hyphenation">-</pc><lb break="no"/>num fluidi supra illud punctum, invenies <add>eam</add> apud omnes fere
      <lb/>scriptores hydrostaticos, apud <rs key="pers_DE-588-119062372" type="person">Varignonium</rs> in <rs type="biblio" key="biblio_XSJACQMG">Co<choice><orig><g ref="#mm">&#xE5D2;</g></orig><reg>mm</reg></choice>entariis
      <lb/>Acad. Regi<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice></rs>, et in <rs type="biblio" key="biblio_AHE68U6J">Actis Lipsiensibus</rs>. Brevitatis <choice><orig>causo</orig><reg>causa</reg></choice> Te
      <lb/>remitto ad <rs key="pers_DE-588-119112450" type="person">Hermanni</rs> <rs key="biblio_WS22BVK4" type="biblio">Phoronomiam</rs> §. 303<choice><orig>.</orig><reg>,</reg></choice> §. 255. Non re<pc type="hyphenation">-</pc><lb break="no"/>cte autem capio, cur petas ut Tibi demonstrem<del>, se</del> hanc alti<pc type="hyphenation">-</pc><lb break="no"/>tudinem pro singulis alicujus sectionis horizontalis punctis
      <lb/>esse eandem; hoc utique satis evidens esse existimo,<del> ex sin-</del>
      <lb/><del>gula eri </del>cum sectio horizontalis parallela sit superficiei
      <lb/>su<choice><orig><g ref="#mm">&#xE5D2;</g></orig><reg>mm</reg></choice><choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice> liquoris in canali stagnantis. <abbr>Ill.<hi rend="sup">mum</hi></abbr> et <abbr>Exc.<hi rend="sup">mum</hi></abbr>
      <lb/>Procuratorem <rs key="pers_DE-588-121843858" type="person">Theupolum</rs> hodie vel cras rursum visitabo.
      <lb/>Repeto ea, qu<choice><orig><g ref="#ae">æ</g></orig><reg>ae</reg></choice> in gratiam <rs key="pers_DE-588-120379260" type="person">Scheuchzeri</rs> nostri Te nudius
      <lb/>tertius rogavi.
  </p>
  <closer><salute>Vale.</salute> <dateline><rs key="place_GEO-3171728" type="place"><abbr>Patav.</abbr></rs> <date when="1718-05-04"><choice><abbr>d.</abbr><expan>die</expan></choice> 4. Mai<choice><orig><g ref="#j">j</g></orig><reg>i</reg></choice> <choice><orig><g ref="#ndot">.</g></orig><reg/></choice>1718</date>.</dateline>
  </closer>
</div>
</body>
