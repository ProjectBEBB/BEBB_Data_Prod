      <addrLine>A Monsieur</addrLine>
      <addrLine>Monsieur <choice><orig>jean</orig><reg>Jean</reg></choice> <choice><orig>bernoulli</orig><reg>Bernoulli</reg></choice></addrLine>
      <addrLine>professeur en philosophie <abbr><choice><orig><g ref="#etlig">&amp;</g></orig><reg>et</reg></choice>c.</abbr></addrLine>
      <addrLine><choice><orig>a</orig><reg>à</reg></choice> <choice><orig>bale</orig><reg>Bale</reg></choice> en Suisse</addrLine>
